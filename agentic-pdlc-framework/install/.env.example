# PDLC Framework — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git — it contains secrets.
# All non-secret config (URLs, IDs, settings) lives in config/integrations.yaml
#
# Setup: cp .env.example .env  →  then fill in your values
# Load:  export $(cat .env | grep -v '^#' | grep -v '^$' | xargs)
# ─────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────────
# ATLASSIAN (Jira + Confluence — same account, usually same token)
# ──────────────────────────────────────────────────────────────────────────────
# How to get: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
JIRA_USER_EMAIL=
JIRA_BASE_URL=https://your-org.atlassian.net

CONFLUENCE_API_TOKEN=          # Usually same as JIRA_API_TOKEN
CONFLUENCE_USER_EMAIL=         # Usually same as JIRA_USER_EMAIL
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki

# ──────────────────────────────────────────────────────────────────────────────
# FIGMA
# ──────────────────────────────────────────────────────────────────────────────
# How to get: figma.com → Settings → Personal access tokens → Generate token
# Scopes needed: File content (read), Dev resources (read)
FIGMA_ACCESS_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# SOURCE CONTROL
# ──────────────────────────────────────────────────────────────────────────────

# GitHub
# How to get: github.com/settings/tokens → Generate new token
# Scopes: repo, read:org, workflow
GITHUB_PERSONAL_ACCESS_TOKEN=

# GitLab (if using GitLab)
# How to get: gitlab.com/-/user_settings/personal_access_tokens
# Scopes: api, read_repository, write_repository
GITLAB_PERSONAL_ACCESS_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4

# Bitbucket (if using Bitbucket)
# How to get: bitbucket.org/account/settings/app-passwords
BITBUCKET_TOKEN=
BITBUCKET_USERNAME=

# Azure DevOps (if using Azure DevOps)
# How to get: dev.azure.com → User Settings → Personal Access Tokens
AZURE_DEVOPS_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# NOTIFICATIONS
# ──────────────────────────────────────────────────────────────────────────────

# Slack
# How to get: api.slack.com/apps → Create App → OAuth & Permissions → Bot Token
# Scopes needed: chat:write, channels:read, users:read
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# Microsoft Teams (if using Teams instead of Slack)
# How to get: Teams → Channel → Connectors → Incoming Webhook
TEAMS_WEBHOOK_URL=

# ──────────────────────────────────────────────────────────────────────────────
# MONITORING (only needed for API-based health checks, not runtime SDK)
# ──────────────────────────────────────────────────────────────────────────────

# Sentry
# How to get: sentry.io → Settings → API → Auth Tokens
SENTRY_AUTH_TOKEN=

# Datadog
# How to get: app.datadoghq.com → Organization Settings → API Keys
DD_API_KEY=
DD_APP_KEY=

# New Relic
# How to get: one.newrelic.com → API keys → Create key (User type)
NEW_RELIC_API_KEY=

# Grafana
# How to get: grafana.com → Profile → API keys
GRAFANA_API_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# LINEAR (if using Linear instead of Jira)
# ──────────────────────────────────────────────────────────────────────────────
# How to get: linear.app → Settings → API → Personal API keys
LINEAR_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# OTHER SERVICES
# ──────────────────────────────────────────────────────────────────────────────

# Anthropic (for Claude API calls if framework makes API calls directly)
ANTHROPIC_API_KEY=

# Vercel (if deploying to Vercel)
VERCEL_TOKEN=

# AWS (if deploying to AWS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# GCP (if deploying to Google Cloud)
GOOGLE_APPLICATION_CREDENTIALS=     # Path to service account JSON file

# Azure (if deploying to Azure)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
